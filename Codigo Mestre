/*
  MEGA MESTRE OBR
  Mestre: relés dos motores e sensores de linha.
  Escrava A2a: ultrassônicos e garra.

  Relés:
  ME_F (2) = motor esquerdo para frente
  ME_R (3) = motor esquerdo para ré
  MD_F (4) = motor direito para frente
  MD_R (5) = motor direito para ré
*/

#include <A2a.h>
#include <Wire.h>

#define ENDERECO_ESCRAVA 8
A2a arduinoMaster;

// ================= RELES DOS MOTORES (MESTRE) =================
#define ME_F 2
#define ME_R 3
#define MD_F 4
#define MD_R 5

// A maioria dos módulos de relé de dois canais é ativa em LOW.
// Se, com todos os relés desligados, os LEDs dos relés acenderem,
// troque true por false.
const bool RELE_ATIVO_EM_LOW = true;
const unsigned long TEMPO_DESLIGADO_ENTRE_TROCAS_MS = 8UL;

// ================= SENSORES DE LINHA =================
#define C1 A7
#define S1 A1
#define S2 A2
#define S3 A3
#define S4 A4
#define S5 A5
#define S6 A11
#define C2 A8

// ================= A2A / ULTRASSONICOS =================
#define VAR_FRENTE 0
#define VAR_ESQUERDA 1
#define VAR_DIREITA 2
#define VAR_TRAS 3

const int DISTANCIA_SEM_ECO_CM = 250;
const int LIMITE_OBSTACULO_CM = 20;
const int LIMITE_PAREDE_CM = 35;
const int LIMITE_VITIMA_CM = 14;
const int LIMITE_DEPOSITO_CM = 18;
const int LIMITE_LATERAL_OBSTACULO_CM = 30;

const unsigned long INTERVALO_LEITURA_US_MS = 100UL;
const unsigned long TEMPO_MAX_GAP_MS = 650UL;
const unsigned long TEMPO_GIRO_DESVIO_MS = 300UL;
const unsigned long TEMPO_MAX_CONTORNO_MS = 2800UL;

int ultraFrente = DISTANCIA_SEM_ECO_CM;
int ultraEsquerda = DISTANCIA_SEM_ECO_CM;
int ultraDireita = DISTANCIA_SEM_ECO_CM;
int ultraTras = DISTANCIA_SEM_ECO_CM;

bool escravaOnline = false;
unsigned long ultimaLeituraUltrassomMs = 0;
unsigned long inicioGapMs = 0;
unsigned long inicioManobraMs = 0;
unsigned long ultimoLogMs = 0;

// ================= ESTADOS =================
enum Estado { LINHA, RESGATE, SAIDA_RESGATE };
enum Direcao { DIRECAO_ESQUERDA, DIRECAO_RETA, DIRECAO_DIREITA };
enum FaseObstaculo {
  SEM_OBSTACULO,
  SAINDO_DA_LINHA,
  CONTORNANDO_OBSTACULO,
  VOLTANDO_PARA_LINHA
};
enum Movimento {
  MOVIMENTO_DESCONHECIDO,
  MOVIMENTO_PARADO,
  MOVIMENTO_FRENTE,
  MOVIMENTO_ESQUERDA,
  MOVIMENTO_DIREITA
};

Estado estadoAtual = LINHA;
Direcao ultimaCorrecao = DIRECAO_RETA;
Direcao ladoDesvio = DIRECAO_DIREITA;
FaseObstaculo faseObstaculo = SEM_OBSTACULO;
Movimento movimentoAtual = MOVIMENTO_DESCONHECIDO;

bool obstaculoFoiVistoPelosSensores = false;
byte leiturasLivres = 0;

// ================= RELES =================
void escreverRele(byte pino, bool ligar) {
  bool nivel = RELE_ATIVO_EM_LOW ? !ligar : ligar;
  digitalWrite(pino, nivel ? HIGH : LOW);
}

void aplicarMovimento(Movimento novoMovimento,
                      bool esquerdoFrente,
                      bool esquerdoRe,
                      bool direitoFrente,
                      bool direitoRe) {
  if (novoMovimento == movimentoAtual) {
    return;
  }

  // Nunca comute frente e ré de um mesmo motor ao mesmo tempo.
  escreverRele(ME_F, false);
  escreverRele(ME_R, false);
  escreverRele(MD_F, false);
  escreverRele(MD_R, false);
  delay(TEMPO_DESLIGADO_ENTRE_TROCAS_MS);

  escreverRele(ME_F, esquerdoFrente);
  escreverRele(ME_R, esquerdoRe);
  escreverRele(MD_F, direitoFrente);
  escreverRele(MD_R, direitoRe);

  movimentoAtual = novoMovimento;
}

void frente() {
  aplicarMovimento(MOVIMENTO_FRENTE, true, false, true, false);
}

void esquerda() {
  aplicarMovimento(MOVIMENTO_ESQUERDA, false, false, true, false);
}

void direita() {
  aplicarMovimento(MOVIMENTO_DIREITA, true, false, false, false);
}

void parar() {
  aplicarMovimento(MOVIMENTO_PARADO, false, false, false, false);
}

// ================= A2A =================
bool escravaResponde() {
  Wire.beginTransmission(ENDERECO_ESCRAVA);
  return Wire.endTransmission() == 0;
}

void atualizarLeituraUltrassom(int &destino, byte variavel) {
  byte valor = arduinoMaster.varWireRead(ENDERECO_ESCRAVA, variavel);

  // O Slave.ino envia 250 sem eco. Zero nao e uma leitura valida de
  // HC-SR04 e costuma indicar ausencia/erro de comunicacao.
  if (valor >= 2 && valor <= DISTANCIA_SEM_ECO_CM) {
    destino = valor;
  }
}

void lerUltrassonicos() {
  if (millis() - ultimaLeituraUltrassomMs < INTERVALO_LEITURA_US_MS) {
    return;
  }

  ultimaLeituraUltrassomMs = millis();
  escravaOnline = escravaResponde();

  // Sem escrava, o mestre continua seguindo linha e os relés continuam
  // funcionando; apenas as funções que dependem dos ultrassônicos são
  // desativadas.
  if (!escravaOnline) {
    ultraFrente = DISTANCIA_SEM_ECO_CM;
    ultraEsquerda = DISTANCIA_SEM_ECO_CM;
    ultraDireita = DISTANCIA_SEM_ECO_CM;
    ultraTras = DISTANCIA_SEM_ECO_CM;
    return;
  }

  atualizarLeituraUltrassom(ultraFrente, VAR_FRENTE);
  atualizarLeituraUltrassom(ultraEsquerda, VAR_ESQUERDA);
  atualizarLeituraUltrassom(ultraDireita, VAR_DIREITA);
  atualizarLeituraUltrassom(ultraTras, VAR_TRAS);
}

void registrarUltrassons() {
  if (millis() - ultimoLogMs < 300UL) {
    return;
  }

  ultimoLogMs = millis();
  Serial.print(F("I2C: "));
  Serial.print(escravaOnline ? F("OK") : F("OFF"));
  Serial.print(F(" | US F/E/D/T: "));
  Serial.print(ultraFrente);
  Serial.print('/');
  Serial.print(ultraEsquerda);
  Serial.print('/');
  Serial.print(ultraDireita);
  Serial.print('/');
  Serial.println(ultraTras);
}

// ================= LINHA E GAP =================
bool linhaVisivel() {
  return digitalRead(S1) == LOW || digitalRead(S2) == LOW ||
         digitalRead(S3) == LOW || digitalRead(S4) == LOW ||
         digitalRead(S5) == LOW || digitalRead(S6) == LOW;
}

void procurarLinhaDepoisDoGap() {
  if (ultimaCorrecao == DIRECAO_ESQUERDA) {
    esquerda();
  } else if (ultimaCorrecao == DIRECAO_DIREITA) {
    direita();
  } else {
    frente();
  }
}

void seguirLinha() {
  int s1 = digitalRead(S1);
  int s2 = digitalRead(S2);
  int s3 = digitalRead(S3);
  int s4 = digitalRead(S4);
  int s5 = digitalRead(S5);
  int s6 = digitalRead(S6);

  if (!linhaVisivel()) {
    if (inicioGapMs == 0) {
      inicioGapMs = millis();
    }

    if (millis() - inicioGapMs <= TEMPO_MAX_GAP_MS) {
      frente();
    } else {
      procurarLinhaDepoisDoGap();
    }
    return;
  }

  inicioGapMs = 0;

  if (s1 == LOW || s2 == LOW) {
    ultimaCorrecao = DIRECAO_ESQUERDA;
    esquerda();
  } else if (s3 == LOW || s6 == LOW) {
    ultimaCorrecao = DIRECAO_RETA;
    frente();
  } else if (s4 == LOW || s5 == LOW) {
    ultimaCorrecao = DIRECAO_DIREITA;
    direita();
  }
}

// ================= OBSTACULO =================
bool obstaculoNosSensoresLateraisOuTras() {
  return ultraEsquerda < LIMITE_LATERAL_OBSTACULO_CM ||
         ultraDireita < LIMITE_LATERAL_OBSTACULO_CM ||
         ultraTras < LIMITE_LATERAL_OBSTACULO_CM;
}

void iniciarDesvioDeObstaculo() {
  ladoDesvio = ultraDireita >= ultraEsquerda ? DIRECAO_DIREITA : DIRECAO_ESQUERDA;
  faseObstaculo = SAINDO_DA_LINHA;
  inicioManobraMs = millis();
  obstaculoFoiVistoPelosSensores = false;
  leiturasLivres = 0;
  Serial.println(F("OBSTACULO NA FRENTE"));
}

void executarDesvioDeObstaculo() {
  if (faseObstaculo == SAINDO_DA_LINHA) {
    if (ladoDesvio == DIRECAO_DIREITA) {
      direita();
    } else {
      esquerda();
    }

    if (millis() - inicioManobraMs >= TEMPO_GIRO_DESVIO_MS) {
      faseObstaculo = CONTORNANDO_OBSTACULO;
      inicioManobraMs = millis();
    }
    return;
  }

  if (faseObstaculo == CONTORNANDO_OBSTACULO) {
    frente();

    if (obstaculoNosSensoresLateraisOuTras()) {
      obstaculoFoiVistoPelosSensores = true;
      leiturasLivres = 0;
    } else if (obstaculoFoiVistoPelosSensores) {
      leiturasLivres++;
    }

    if ((obstaculoFoiVistoPelosSensores && leiturasLivres >= 3) ||
        millis() - inicioManobraMs >= TEMPO_MAX_CONTORNO_MS) {
      faseObstaculo = VOLTANDO_PARA_LINHA;
      inicioManobraMs = millis();
    }
    return;
  }

  if (faseObstaculo == VOLTANDO_PARA_LINHA) {
    if (ladoDesvio == DIRECAO_DIREITA) {
      esquerda();
    } else {
      direita();
    }

    if (millis() - inicioManobraMs >= TEMPO_GIRO_DESVIO_MS) {
      faseObstaculo = SEM_OBSTACULO;
      inicioGapMs = 0;
    }
  }
}

// ================= RESGATE =================
void modoResgate() {
  registrarUltrassons();

  if (!escravaOnline) {
    parar();
    Serial.println(F("SEM ESCRAVA: RESGATE PAUSADO"));
    return;
  }

  if (ultraFrente < LIMITE_VITIMA_CM) {
    parar();
    Serial.println(F("OBJETO FRONTAL: POSSIVEL VITIMA/PAREDE"));
    return;
  }

  if (ultraTras < LIMITE_DEPOSITO_CM) {
    Serial.println(F("TRAS: POSSIVEL PONTO DE DEPOSITO"));
  }

  frente();
}

void sairResgate() {
  if (digitalRead(S6) == LOW) {
    estadoAtual = LINHA;
    inicioGapMs = 0;
  } else {
    frente();
  }
}

// ================= SETUP E LOOP =================
void setup() {
  Serial.begin(9600);
  arduinoMaster.begin();

  pinMode(ME_F, OUTPUT);
  pinMode(ME_R, OUTPUT);
  pinMode(MD_F, OUTPUT);
  pinMode(MD_R, OUTPUT);

  pinMode(C1, INPUT);
  pinMode(C2, INPUT);
  pinMode(S1, INPUT);
  pinMode(S2, INPUT);
  pinMode(S3, INPUT);
  pinMode(S4, INPUT);
  pinMode(S5, INPUT);
  pinMode(S6, INPUT);

  parar();
  Serial.println(F("MEGA MESTRE OBR ONLINE"));
}

void loop() {
  lerUltrassonicos();

  switch (estadoAtual) {
    case LINHA:
      if (escravaOnline && faseObstaculo != SEM_OBSTACULO) {
        executarDesvioDeObstaculo();
      } else if (escravaOnline && ultraFrente < LIMITE_OBSTACULO_CM) {
        iniciarDesvioDeObstaculo();
      } else {
        seguirLinha();
      }

      if (escravaOnline && digitalRead(C1) == HIGH && digitalRead(C2) == HIGH) {
        estadoAtual = RESGATE;
        faseObstaculo = SEM_OBSTACULO;
        Serial.println(F("ENTRANDO NO RESGATE"));
      }
      break;

    case RESGATE:
      modoResgate();
      break;

    case SAIDA_RESGATE:
      sairResgate();
      break;
  }
}
